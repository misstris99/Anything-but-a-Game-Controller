<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for ControllerActivity.
    Stage 2B adds connection controls (Server IP, Room Code, Connect button)
    and live connection/latency status, while retaining sensor debug readouts.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── App title ─────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/familjen_grotesk_semibold"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="24sp" />

        <!-- ── QR Scanner Button ─────────────────────────────── -->
        <Button
            android:id="@+id/btn_scan_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="20dp"
            android:background="@color/teal"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/familjen_grotesk_semibold"
            android:text="@string/btn_scan_qr"
            android:textSize="14sp" />

        <!-- ── Connection Section ────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Label"
            android:text="@string/label_server_ip" />

        <EditText
            android:id="@+id/et_server_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:hint="@string/hint_server_ip"
            android:textColorHint="@color/disabled"
            android:inputType="textUri|textNoSuggestions"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Label"
            android:text="@string/label_room_code" />

        <EditText
            android:id="@+id/et_room_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:hint="@string/hint_room_code"
            android:textColorHint="@color/disabled"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="4"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:background="@color/accent"
            android:textColor="@color/bg"
            android:fontFamily="@font/familjen_grotesk_semibold"
            android:text="@string/btn_connect"
            android:textSize="14sp" />

        <!-- ── Connection & Latency Readout ───────────────────── -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:text="@string/status_disconnected"
            android:textColor="@color/disabled" />

        <TextView
            android:id="@+id/tv_latency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:text="@string/latency_placeholder"
            android:textColor="@color/disabled" />

        <!-- ── Accelerometer section ─────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Label"
            android:text="@string/label_accel" />

        <TextView
            android:id="@+id/tv_accel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:text="x: —  y: —  z: —" />

        <!-- ── Gyroscope section ──────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Label"
            android:text="@string/label_gyro" />

        <TextView
            android:id="@+id/tv_gyro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:text="x: —  y: —  z: —" />

        <!-- ── Computed tilt output ───────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            style="@style/Label"
            android:text="@string/label_tilt_out" />

        <TextView
            android:id="@+id/tv_tilt_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="12dp"
            style="@style/Mono"
            android:textColor="@color/accent"
            android:text="x: —  y: —" />

    </LinearLayout>

</ScrollView>
